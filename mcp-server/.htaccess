# MCP server code (public URLs /mcp and /mcp/… are rewritten here by the root .htaccess)

# No RewriteEngine here on purpose: a RewriteEngine in this folder replaces
# the root .htaccess's rules for it, which stopped the root rewrite of /mcp
# into this folder from working on IONOS (BUG-023). The root .htaccess
# passes the Authorization header through (PHP sees HTTP_AUTHORIZATION or
# REDIRECT_HTTP_AUTHORIZATION — mcp-server/index.php checks both).


# Server config is never served directly
<Files "config.php">
    Order deny,allow
    Deny from all
</Files>

# index.php (the MCP endpoint) and setup.php are intentionally public.
# lib/ has its own Deny-from-all .htaccess. ui/board.html is public on
# purpose — it's the MCP App view, also served via resources/read.

