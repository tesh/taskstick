# MCP server directory

# Pass the Authorization header through to PHP (Apache strips it by default
# on some hosts, IONOS included).
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# /mcp (no trailing slash, the canonical URL) maps to this directory, so
# this file's rewrite rules apply to it rather than the root .htaccess's.
# Route it to the endpoint here (DirectorySlash is off below).
RewriteCond %{REQUEST_URI} ^/mcp$
RewriteRule ^ /mcp/index.php [L,QSA]

# Server config is never served directly
<Files "config.php">
    Order deny,allow
    Deny from all
</Files>

# index.php (the MCP endpoint) and setup.php are intentionally public.
# lib/ has its own Deny-from-all .htaccess. ui/board.html is public on
# purpose — it's the MCP App view, also served via resources/read.

# /mcp (no trailing slash) is the canonical MCP URL. Stop Apache from
# 301-redirecting it to /mcp/ — a redirect turns a client's POST into a GET.
# The root .htaccess rewrites /mcp to mcp/index.php.
DirectorySlash Off
DirectoryIndex index.php
