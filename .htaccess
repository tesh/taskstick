Options -Indexes

# Without explicit cache headers, browsers fall back to heuristic caching
# (roughly 10% of file age) — meaning manifest.json/index.html/sw.js can be
# served from the browser's own HTTP cache without ever re-checking the
# server, even on a "fresh" revisit or PWA reinstall. That's why an icon
# update didn't show up after deleting and reinstalling the app: the
# manifest itself was stale, so it never pointed at the new icon URL.
# Force these three to always revalidate with the server (cheap 304s when
# unchanged, but guarantees updates are seen on the very next request).
<IfModule mod_headers.c>
  <FilesMatch "^(manifest\.json|index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Force HTTPS
RewriteEngine On
# IONOS maps docroots in a way that breaks relative rewrite targets unless
# RewriteBase is set (BUG-023).
RewriteBase /
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Some hosts (IONOS included, confirmed 2026-08-20) don't pass the
# Authorization header through to PHP's $_SERVER by default — it's
# commonly reserved for Apache's own Basic Auth handling. This re-exposes
# it as HTTP_AUTHORIZATION regardless, which api/apple-export.php's
# headless bearer-token auth needs (no PHP session to authenticate the
# Mac helper app with, unlike every other endpoint in this app).
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# MCP OAuth discovery (RFC 8414 / RFC 9728). Both the root and the
# path-suffixed forms (e.g. /.well-known/oauth-protected-resource/mcp/) map to
# the same documents — there is only one MCP server on this host.
RewriteRule ^\.well-known/oauth-authorization-server(/.*)?$ oauth/metadata.php?doc=as  [L]
RewriteRule ^\.well-known/oauth-protected-resource(/.*)?$   oauth/metadata.php?doc=prm&path=$1 [L]

# MCP server. Public URLs: /mcp (canonical; /mcp/ also works) and /mcp/…
# The code lives in mcp-server/; mcp-endpoint.php and mcp-setup.php are root
# stubs (not "mcp.php": MultiViews would map /mcp/anything onto it first).
# There must be NO real mcp/ directory: Apache would 301 /mcp → /mcp/, and
# clients (Claude, Cursor) strip the trailing slash (BUG-023).
RewriteRule ^mcp/?$ mcp-endpoint.php [L,QSA]
RewriteRule ^mcp/setup\.php$ mcp-setup.php [L,QSA]
RewriteRule ^mcp/(.+)$ mcp-server/$1 [L,QSA]

# Route /auth/login  → auth/login.php
RewriteRule ^auth/login$  auth/login.php  [L]
# Route /auth/callback → auth/callback.php
RewriteRule ^auth/callback$ auth/callback.php [L]
# Route /auth/logout  → auth/logout.php
RewriteRule ^auth/logout$  auth/logout.php  [L]

# Route /api/lists → api/lists.php
RewriteRule ^api/lists$  api/lists.php  [L,QSA]
# Route /api/tasks → api/tasks.php
RewriteRule ^api/tasks$  api/tasks.php  [L,QSA]
# Route /api/auth/status → api/auth-status.php
RewriteRule ^api/auth/status$ api/auth-status.php [L]

# Serve index.html for all other routes (SPA fallback). The REQUEST_URI
# guard stops the rewrite from re-applying to /index.html itself — without
# it IONOS looped and returned 500 for any unknown path (BUG-022).
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
